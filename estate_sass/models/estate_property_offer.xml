<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="model_real_estate_property_offer" model="ir.model">
        <field name="name">Real Estate Property Offer</field>
        <field name="model">x_estate.property.offer</field>
    </record>

    <record id="field_real_estate_property_offer_price" model="ir.model.fields">
        <field name="model_id" ref="estate_sass.model_real_estate_property_offer" />
        <field name="name">x_price</field>
        <field name="field_description">Price</field>
        <field name="ttype">float</field>
        <field name="required">True</field>
    </record>

    <record id="field_real_estate_property_offer_partner_id" model="ir.model.fields">
        <field name="model_id" ref="estate_sass.model_real_estate_property_offer" />
        <field name="name">x_partner_id</field>
        <field name="field_description">Buyer</field>
        <field name="ttype">many2one</field>
        <field name="required">True</field>
        <field name="relation">res.partner</field>
        <field name="on_delete">restrict</field>
    </record>

    <record id="field_real_estate_property_offer_property_id" model="ir.model.fields">
        <field name="model_id" ref="estate_sass.model_real_estate_property_offer" />
        <field name="name">x_property_id</field>
        <field name="field_description">Property</field>
        <field name="ttype">many2one</field>
        <field name="required">True</field>
        <field name="relation">x_estate.property</field>
        <field name="on_delete">restrict</field>
    </record>

    <record id="field_real_estate_property_offer_status" model="ir.model.fields">
        <field name="model_id" ref="estate_sass.model_real_estate_property_offer" />
        <field name="name">x_status</field>
        <field name="field_description">Status</field>
        <field name="ttype">selection</field>
    </record>

    <!-- Selection Values -->
    <record id="selection_real_estate_property_offer_status_accepted"
        model="ir.model.fields.selection">
        <field name="field_id" ref="field_real_estate_property_offer_status" />
        <field name="name">Accepted</field>
        <field name="value">accepted</field>
        <field name="sequence">1</field>
    </record>

    <record id="selection_real_estate_property_offer_status_refused"
        model="ir.model.fields.selection">
        <field name="field_id" ref="field_real_estate_property_offer_status" />
        <field name="name">Refused</field>
        <field name="value">refused</field>
        <field name="sequence">2</field>
    </record>

    <record id="action_x_estate_property_offer_accept" model="ir.actions.server">
        <field name="name">Accept Offer</field>
        <field name="model_id" ref="estate_sass.model_real_estate_property_offer"></field>
        <field name="state">code</field>
        <field name="code"><![CDATA[ 
    for record in records:
        record.write({'x_status':'accepted'})
        
        property_record = record.x_property_id
        property_record.write({
           'x_selling_price':record.x_price,
           'x_partner_id':record.x_partner_id.id        
        })
        other_offers = env['x_estate.property.offer'].search([
           ('x_property_id','=',property_record.id),
           ('id','!=',record.id)    
        ])
        other_offers.write({'x_status':'refused'})
        ]]>

      </field>
    </record>


</odoo>
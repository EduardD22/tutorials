<?xml version="1.0"?>
<odoo>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.offer.form</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <group>
                    <field name="x_price" />
                    <field name="x_partner_id" />
                    <field name="x_status" />
                </group>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">x_estate.property.offer.list</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="x_price" />
                <field name="x_partner_id" />
                <field name="x_status" optional="hide" />
                <button name="estate_sass.action_x_estate_property_offer_accept" type="action" string="Accept"  />
            </list>
        </field>
    </record>

</odoo>
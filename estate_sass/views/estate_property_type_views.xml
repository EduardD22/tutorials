<?xml version="1.0"?>
<odoo>
    <record id="estate_property_type_list_view" model="ir.ui.view">
        <field name="name">x_estate.property.type.list</field>
        <field name="model">x_estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name" />
            </list>
        </field>
    </record>

    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">x_estate.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your property types!
            </p>
        </field>
    </record>

</odoo>
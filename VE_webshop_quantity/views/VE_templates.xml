     <template id="product_quantity_inherit" inherit_id="website_sale.product_quantity">
        <xpath expr="//input[@name='add_qty']" position="replace">
            <input type="text" class="form-control quantity text-center"
                   style="min-width: 100px;"
                   t-att-data-webshop-quantity="product.webshop_quantity"
                   t-att-data-webshop-minimum-quantity="product.webshop_minimum_quantity"
                   name="add_qty" t-att-value="product.webshop_minimum_quantity"/>
        </xpath>
    </template>
</odoo>